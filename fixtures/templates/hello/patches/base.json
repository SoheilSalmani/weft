{
  "description": "Initial scaffold: README and pyproject.",
  "tags": [
    "scaffold"
  ],
  "ops": [
    {
      "op": "create_file",
      "path": "README.md",
      "content": [
        [
          "# ",
          {
            "answer": "project_name"
          }
        ],
        "",
        "Scaffolded by weft."
      ]
    },
    {
      "op": "create_file",
      "path": "pyproject.toml",
      "content": [
        "[project]",
        [
          "name = \"",
          {
            "answer": "package_name"
          },
          "\""
        ],
        "version = \"0.1.0\""
      ]
    }
  ],
  "hooks": [
    {
      "id": "mark-synced",
      "phase": "post",
      "effect": "setup",
      "label": "Record that dependencies synced",
      "action": "echo synced > .task-ran",
      "inputs": ["glob:pyproject.toml"]
    }
  ]
}
